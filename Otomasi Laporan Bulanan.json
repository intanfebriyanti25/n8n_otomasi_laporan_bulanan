    {
      "parameters": {
        "jsCode": "const rows = $input.all().flatMap(i =>\n  Array.isArray(i.json) ? i.json : [i.json]\n);\n\nconst toNum = v => typeof v === 'number'\n  ? v\n  : parseFloat(String(v ?? '').replace(/[^0-9.\\-]/g, '')) || 0;\n\nconst namaBulan = ['januari','februari','maret','april','mei','juni','juli',\n  'agustus','september','oktober','november','desember'];\nconst now = new Date();\n\n// Parameter uji: data dummy berisi tahun 2025.\n// Setelah screenshot, ubah keduanya menjadi null.\nconst BULAN_UJI = 'oktober';\nconst TAHUN_UJI = 2025;\n\nconst bulanIni = BULAN_UJI || namaBulan[now.getMonth()];\nconst tahun = TAHUN_UJI || now.getFullYear();\n\nconst dataBulanIni = rows.filter(r => {\n  const bulanCocok = String(r['Bulan'] || '').trim().toLowerCase() === bulanIni;\n  const m = String(r['Tanggal Laporan'] || '').match(/\\d{4}/);\n  const tahunCocok = m ? Number(m[0]) === tahun : true;\n  return bulanCocok && tahunCocok;\n});\n\nconst totalPenjualan = dataBulanIni.reduce((s, r) => s + toNum(r['Penjualan (Unit)']), 0);\nconst totalPendapatan = dataBulanIni.reduce((s, r) => s + toNum(r['Pendapatan (IDR)']), 0);\nconst jumlah = dataBulanIni.length;\n\nconst st = r => String(r['Status'] || '').trim().toLowerCase();\nconst SUDAH = ['tercapai', 'achieved'];\nconst BELUM = ['belum tercapai', 'tidak tercapai', 'not achieved'];\nconst dinilai = dataBulanIni.filter(r => [...SUDAH, ...BELUM].includes(st(r)));\nconst achieved = dinilai.filter(r => SUDAH.includes(st(r))).length;\n\nreturn [{\n  json: {\n    'Periode': `${bulanIni.charAt(0).toUpperCase() + bulanIni.slice(1)} ${tahun}`,\n    'Total Penjualan (Unit)': totalPenjualan,\n    'Total Pendapatan (IDR)': totalPendapatan,\n    'Rata-rata Penjualan': jumlah ? Math.round(totalPenjualan / jumlah) : 0,\n    'Rata-rata Pendapatan': jumlah ? Math.round(totalPendapatan / jumlah) : 0,\n    'Jumlah Laporan': jumlah,\n    'Achievement Rate (%)': dinilai.length ? Math.round((achieved / dinilai.length) * 100) : 0,\n    'Tanggal Generate': now.toISOString().slice(0, 10)\n  }\n}];"
      },
